<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library, not an executable. That single line is stage B's whole premise:
       an ASP.NET Core host cannot sensibly reference a console Exe, so the
       domain, the extractors, the tools and the run orchestration had to stop
       living in the same project as Main. What is left here is everything that
       does not know how it is being invoked; src/CreServicing.Cli and
       src/CreServicing.Api are the two things that do. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CreServicing.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same pins as the course repo, so the instructor's snippets paste in
         without API drift. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.3.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.5.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixtures are data, not code. Copied next to the binary so whatever is
         hosting this library finds them the same way — console, web host, or
         test runner. Content flows transitively across ProjectReference, which
         is why neither the CLI nor the API restates this. -->
    <Content Include="fixtures\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
